# Copy this file to .env and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# The anon key is safe to ship in the client bundle — it identifies the
# project, not a user. Every table it can reach is locked down by row-level
# security policies keyed on auth.uid(), so this key alone can't read or
# write another user's data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat's per-platform PUBLIC SDK keys (Project Settings -> API Keys in the RevenueCat
# dashboard — use the "Public app-specific API key" for each app, not a secret key). Like the
# Supabase anon key, these identify the app, not a user, and are meant to ship in the client.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your-ios-public-sdk-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your-android-public-sdk-key
