# Metro resolves modules by walking node_modules directories on disk, and it does not understand
# pnpm's symlinked store layout. Without hoisting, every package that Metro reaches only
# transitively has to be promoted to an explicit direct dependency before a bundle will build —
# which is how @supabase/*, @revenuecat/*, tslib, iceberg-js, expo-application, badgin,
# @expo/metro-runtime, expo-modules-core and @react-native/normalize-colors all ended up in
# apps/mobile/package.json despite nothing in our code importing them.
#
# node-linker=hoisted makes node_modules look the way npm/yarn build it, which is what Metro (and
# Expo's own monorepo guidance) expects. It costs pnpm's strictness, and buys a build that doesn't
# break every time a dependency reorganises its internals.
node-linker=hoisted
